{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Backend Server",
      "program": "${workspaceFolder}/backend/main.js",
      "envFile": "${workspaceFolder}/backend/.env",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "restart": true
    },
    {
      "type": "node-terminal",
      "name": "Run Script: start (backend)",
      "request": "launch",
      "command": "npm run start",
      "cwd": "${workspaceFolder}/backend"
    }
  ]
}